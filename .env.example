# ====================================================================
# Restored 环境变量示例
# 复制本文件为 .env.local 并填入真实值：cp .env.example .env.local
# ====================================================================

# ---- Supabase ----
# 项目 URL，形如 https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# 匿名密钥（前端可见，配合 RLS 使用）
# Supabase Dashboard → Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# 服务端密钥（绕过 RLS，仅服务端使用；城市同步 / seed 脚本必需）
# Supabase Dashboard → Settings → API → Project API keys → service_role
# 切勿提交到仓库或暴露给前端
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---- 高德地图 Web 服务 ----
# 用于 IP 定位 + 逆地理编码
# 申请：https://lbs.amap.com/api/webservice/guide/api/ipconfig
GAODE_IP_KEY="your-amap-web-service-key"

# ---- 应用配置 ----
# 应用主域名，用于回调与自引用链接（开发环境用 http://localhost:3000）
APP_URL="http://localhost:3000"

# 保护 /api/cities/sync 的管理员密钥（自定义随机字符串即可）
ADMIN_SYNC_KEY="your-random-admin-sync-secret"

# ---- 可选 ----
# Gemini AI（按需，未启用可留空）
GEMINI_API_KEY=""
